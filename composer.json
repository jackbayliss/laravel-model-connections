{
  "name": "jackbayliss/laravel-model-connection",
  "description": "Define separate read/write database connections per Eloquent model.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "eloquent", "database", "connections", "read-write"],
  "authors": [
    {
      "name": "Jack Bayliss",
      "email": "jjbdev@proton.me"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.27"
  },
  "autoload": {
    "psr-4": {
      "JackBayliss\\LaravelModelConnection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JackBayliss\\LaravelModelConnection\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --parallel",
    "analyse": "phpstan analyse --memory-limit=512M",
    "lint": "pint --parallel"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
